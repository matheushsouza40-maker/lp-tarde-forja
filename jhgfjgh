/* ================= RESET E FONT ================= */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
    scroll-behavior: smooth;
}

/* ================= LINKS ================= */
a {
    text-decoration: underline;
    text-decoration-color: rgb(240, 243, 54);
    color: inherit;
    transition: opacity 0.2s ease;
}

a:hover {
    cursor: pointer;
    opacity: 0.7;
}

/* ================= ICONS ================= */
i {
    font-size: 30px;
    transition: transform 0.2s ease, color 0.2s ease;
}

i:hover {
    transform: translateY(-5px);
    color: dodgerblue;
}

/* ================= NAV ================= */
nav {
    position: fixed;
    top: 0;
    width: 100%;
    height: 80px;
    z-index: 999;
    background: cornflowerblue;
    box-shadow: 0 3px 10px rgba(0,0,0,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
}

header nav a {
    margin: 0 15px;
    display: inline-block;
}

/* ================= CARDS E TEXTOS ================= */
.cards h1,
.cards h2,
.cards p {
    text-align: center;  
    margin: 10px 0;
}

.contact-form h2,
.contact-form label,
.contact-form input,
.contact-form textarea,
.contact-form button {
    text-align: center;
    display: block;
    margin: 10px auto;  
}

/* ================= IMAGENS ================= */
.cards img,
.video {
    display: block;
    margin: 20px auto;
}

/* ================= SECTION 1 ================= */
#s1 {
    min-height: 100vh;
    padding-top: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 40px;
}

/* ================= SECTION 2 ================= */
#s2 {
    min-height: 100vh;
    background: url('./images/bg2.jpg') center/cover fixed no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    padding: 50px;
}

.card {
    width: 300px;
    background: white;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
}

.card img {
    width: 100%;
    height: 200px;
    object-fit: cover;  
}

.wrapTexts {
    padding: 20px;
}

/* ================= SECTION 3 ================= */
#s3 {
    min-height: 100vh;
    padding-top: 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
}

/* ================= SECTION 4 ================= */
#s4 {
    min-height: 100vh;
    padding-top: 80px;
    text-align: center;
}

/* ================= SECTION 5 ================= */
#s5 {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    text-align: center;
}

/* ================= FORM ================= */
.formulario {
    width: 320px;
    padding: 20px;
    border: 2px solid black;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.formulario label,
.formulario input,
.formulario textarea,
.formulario button {
    text-align: center;
    display: block;
    margin: 10px auto;
}

.formulario textarea {
    resize: none;
    height: 120px;
}

.formulario button {
    padding: 10px;
    cursor: pointer;
}

/* ================= FOOTER ================= */
footer {
    height: 50px;
    box-shadow: 0 -3px 10px rgba(0,0,0,0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
}

/* ================= RESPONSIVO ================= */
@media (max-width: 1000px) {
    #s1 { padding-top: 100px; }
    #s2 { padding-top: 120px; }
}
